# dependencies
node_modules/

# env — secrets. Every .env is ignored; the .example templates are not.
.env
.env.*
!.env.example
!**/.env.example

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native build output (generated by `expo prebuild` — not source)
/app/ios/
/app/android/

# next / vercel
.next/
out/
.vercel/

# Google OAuth client secret files, as downloaded from the Cloud Console
client_secret*.json

# native signing material — never commit these
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# metro
.metro-health-check*

# debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# typescript
*.tsbuildinfo

# tooling artifacts
.playwright-mcp/
.claude/settings.local.json

# Play service account key — a credential, never committed
secrets/

{
  "expo": {
    "name": "Curb",
    "slug": "curb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "curb",
    "userInterfaceStyle": "dark",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "app.joincurb.curb",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1113",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "package": "app.joincurb.curb",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#3FDE9C",
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#3FDE9C",
      "androidMode": "default",
      "androidCollapsedTitle": "Reminders"
    },
    "backgroundColor": "#07080A",
    "description": "Quit any addiction. A private, on-device recovery companion.",
    "primaryColor": "#3FDE9C",
    "owner": "gyanendrasingh2003",
    "extra": {
      "eas": {
        "projectId": "61ba9994-90aa-4962-b8f0-a05823981145"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/61ba9994-90aa-4962-b8f0-a05823981145"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

# ── RevenueCat (app side) ───────────────────────────────────────────────────
# PUBLISHABLE SDK keys. These ship inside the app binary by design — they can
# only start purchases, never read or refund. The SECRET key (sk_…) belongs on
# the server as REVENUECAT_API_KEY and must never appear here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Where the auth/entitlement backend lives. Only set this to point a dev build
# at something other than production.
# EXPO_PUBLIC_AUTH_URL=https://joincurb.app

# ── PostHog ─────────────────────────────────────────────────────────────────
# Read by app.config.js at build time and injected into expoConfig.extra, so
# these deliberately have no EXPO_PUBLIC_ prefix — app.config.js runs in Node.
# The phc_ token is a client-side write key and ships in the binary by design.
# EAS builds do NOT read this file (it is gitignored and never uploaded), so
# the same values are duplicated into eas.json's per-profile `env` blocks.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

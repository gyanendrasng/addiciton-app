# ── Database ────────────────────────────────────────────────────────────────
# Neon / Vercel Postgres connection string. Drizzle and Better Auth share it.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Better Auth ─────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://joincurb.app

# ── Sign in with Apple ──────────────────────────────────────────────────────
# The iOS bundle id. This is the ONE value that matters: the native flow
# verifies its identity token against it (idToken.audience).
APPLE_BUNDLE_ID=app.joincurb.curb
#
# Not needed while Apple sign-in is iOS-only. A Services ID and a signed
# client-secret JWT are required only for the WEB redirect flow — add both
# (APPLE_CLIENT_ID, APPLE_CLIENT_SECRET) if an Apple button ever appears on
# the website. The JWT expires every 6 months, so don't take that on early.
# APPLE_CLIENT_ID=app.joincurb.curb.signin
# APPLE_CLIENT_SECRET=

# ── Google Sign-In ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (sign-in codes) ───────────────────────────────────────────────────
# Without a key, codes are printed to the server log in development.
RESEND_API_KEY=
MAIL_FROM=Curb <hello@joincurb.app>

# ── RevenueCat ──────────────────────────────────────────────────────────────
# Shared secret you set in the dashboard's webhook Authorization header
REVENUECAT_WEBHOOK_SECRET=
# V2-version secret key (sk_...) with customer_information:customers:read.
# v1 keys do NOT work on the v2 API. Without these two the webhook falls back
# to reading the event payload instead of reconciling.
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
# Entitlement identifier configured in RevenueCat
REVENUECAT_ENTITLEMENT_ID=premium
